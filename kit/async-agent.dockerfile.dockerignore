# Only compilation inputs and the three runtime assets enter this kit's context.
**
!go.mod
!go.sum
!main.go
!cmd/**/*.go
!pkg/**/*.go
!pkg/app/export/export.css
!pkg/app/export/export.html
!pkg/app/export/export.js
